{
  "name": "blog.sakupi01.com",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cached": "astro build -- --force",
    "preview": "astro preview",
    "preview:cloudflare": "pnpm build && wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "test:agent-ready:unit": "node --test test/markdown-alternates.test.mjs test/worker.test.mjs",
    "test:agent-ready:artifacts": "node --test test/agent-ready-build.test.mjs",
    "test:agent-ready:build": "pnpm test:agent-ready:unit && pnpm build && pnpm test:agent-ready:artifacts",
    "test:agent-ready:live": "node --test test/agent-ready-live.test.mjs",
    "test:agent-ready:live:local": "AGENT_READY_MODE=local AGENT_READY_BASE_URL=http://127.0.0.1:8787 pnpm test:agent-ready:live",
    "test:agent-ready:live:preview": "AGENT_READY_MODE=preview pnpm test:agent-ready:live",
    "test:agent-ready:live:rehearsal": "AGENT_READY_MODE=rehearsal pnpm test:agent-ready:live",
    "test:agent-ready:live:production": "AGENT_READY_MODE=production AGENT_READY_BASE_URL=https://blog.sakupi01.com pnpm test:agent-ready:live",
    "astro": "astro",
    "check": "pnpm check:typecheck && pnpm check:lint && pnpm check:format && pnpm check:markuplint",
    "check:textlint": "textlint \"**/*.md\"",
    "check:textlint:fix": "textlint \"**/*.md\" --fix",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "check:typecheck": "astro sync && tsc --noEmit",
    "check:markuplint": "markuplint \"./app/**/*.{jsx,tsx}\"",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint --fix ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@remark-embedder/core": "^3.0.3",
    "@remark-embedder/transformer-oembed": "^5.0.0",
    "@sakupi01/layout": "workspace:*",
    "@sakupi01/style": "workspace:*",
    "add": "^2.0.6",
    "astro": "^7.3.8",
    "hastscript": "^9.0.0",
    "he": "^1.2.0",
    "marked": "^15.0.7",
    "open-graph-scraper": "^6.11.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-pretty-code": "0.13.0",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-collapse": "0.1.2",
    "remark-directive": "3.0.0",
    "remark-gfm": "4.0.0",
    "remark-link-card": "1.3.1",
    "remark-stringify": "^11.0.0",
    "remark-toc": "9.0.0",
    "sanitize-filename": "^1.6.3",
    "sharp": "catalog:",
    "unist-util-visit": "^5.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@proofdict/textlint-rule-proofdict": "3.1.2",
    "@types/hast": "^3.0.5",
    "@types/he": "1.2.3",
    "@types/mdast": "4.0.4",
    "@types/sanitize-filename": "1.6.3",
    "mdast-util-directive": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "unified": "^11.0.5",
    "wrangler": "^4.160.1"
  }
}
