---
import "@sakupi01/style";
import "@sakupi01/style/sakupi01.com.css";
import MinimalDocument from "@sakupi01/layout/components/MinimalDocument.astro";
import GoneWrong from "@sakupi01/layout/components/GoneWrong.astro";
import { site } from "../data/site";
---

<MinimalDocument
  site={site}
  pageTitle="Not Found"
  description="This page could not be found."
  type="website"
  bodyClass="grid--centered"
>
  <GoneWrong status={404} />
  <main class="stack">
    <h1>Page not found</h1>
    <p>
      The requested page does not exist. Return to the <a href="/"
        >blog archive</a
      >, inspect the <a href="/sitemap-index.xml">sitemap</a>, or read
      <a href="/llms.txt">llms.txt</a> for agent-friendly navigation.
    </p>
  </main>
</MinimalDocument>
