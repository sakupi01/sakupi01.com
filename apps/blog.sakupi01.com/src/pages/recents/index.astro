---
import "@sakupi01/style";
import "@sakupi01/style/sakupi01.com.css";
import BlogPostCard from "../../components/BlogPostCard.astro";
import BaseLayout from "@sakupi01/layout/components/BaseLayout.astro";
import { site } from "../../data/site";
import { allPosts } from "../../utils/contents";

// Opt in to responsive iframe sizing (frame-sizing) for the sakupi01.com embed.
const homeOrigin = new URL(import.meta.env.PUBLIC_HOME).origin;
---

<BaseLayout
  site={site}
  pageTitle="Recent Blogs Archive"
  description="Recent Blogs Archive"
  type="article"
>
  <meta
    slot="head-extra"
    name="responsive-embedded-sizing"
    content={`allow-origins=${homeOrigin}`}
  />
  <script is:inline slot="head-extra">
    // Web fonts can change the content height after the initial sizing.
    if ("requestResize" in window) {
      document.fonts.ready.then(() => window.requestResize());
    }
  </script>
  <main>
    <ul class="stack">
      {
        allPosts.slice(0, 4).map((post) => {
          const url = post.data.tags.includes("zenn")
            ? `${import.meta.env.PUBLIC_ZENN_BASE_URL}${post.id}`
            : `${import.meta.env.PUBLIC_BLOG}${post.id}`;
          return (
            <BlogPostCard
              url={url}
              title={post.data.title}
              date={post.data.date}
              excerpt={post.data.excerpt}
              target="_parent"
            />
          );
        })
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .stack {
    --stack-gutter: var(--s-space-gutter-xl);
  }

  main {
    padding: 0;
  }
</style>
