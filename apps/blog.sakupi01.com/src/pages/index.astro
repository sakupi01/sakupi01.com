---
import BlogPostCard from "../components/BlogPostCard.astro";
import Title from "@sakupi01/layout/components/Title.astro";
import Layout from "../layouts/Layout.astro";
import { allPosts } from "../utils/contents";
import { postUrl } from "../utils/postUrl";
---

<Layout pageTitle="Archive" description="Blog Archive" url="/">
  <Title title="Archive | blog.sakupi01.com" />
  <ul class="stack">
    {
      allPosts.map((post) => (
        <BlogPostCard
          url={postUrl(post)}
          title={post.data.title}
          date={post.data.date}
          excerpt={post.data.excerpt}
        />
      ))
    }
  </ul>
</Layout>

<style>
  .stack {
    --stack-gutter: var(--s-space-gutter-xl);
  }
</style>
