---
import BlogPostCard from "../../components/BlogPostCard.astro";
import Title from "@sakupi01/layout/components/Title.astro";
import Layout from "../../layouts/Layout.astro";
import { allTechPosts } from "../../utils/contents";
import { postUrl } from "../../utils/postUrl";
---

<Layout
  pageTitle="Tech Articles Archive"
  description="Tech Articles Archive"
  url="/dev/"
>
  <Title title="Tech Articles Archive ..." />
  <ul class="stack">
    {
      allTechPosts.map((post) => {
        return (
          <BlogPostCard
            url={postUrl(post)}
            title={post.data.title}
            date={post.data.date}
            excerpt={post.data.excerpt}
          />
        );
      })
    }
  </ul>
</Layout>

<style>
  .stack {
    --stack-gutter: var(--s-space-gutter-xl);
  }
</style>
