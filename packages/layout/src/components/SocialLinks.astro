---
import { socialLinks } from "../data/profile";
---

<ul class="sns">
  {
    socialLinks.map(({ label, href }) => (
      <li>
        <a href={href} class="sns-link">
          {label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .sns {
    display: grid;
    font-family: var(--s-font-family-serif);
    gap: var(--s-space-gap-xs);
    grid-auto-columns: max-content;
    grid-auto-flow: column;
  }
</style>
